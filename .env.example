NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# TikHub API (required for TikTok data sync)
TIKHUB_API_KEY=your-tikhub-api-key
# Optional: use China domain (https://api.tikhub.dev)
# TIKHUB_USE_CHINA_DOMAIN=true
# Optional: override API base URL
# TIKHUB_API_BASE_URL=https://api.tikhub.io

# Required for AI Insights (server-side only, never commit real keys)
# Can also be saved in Supabase via Settings page (takes priority over env)
GEMINI_API_KEY=your-gemini-api-key
# Default: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# Vidmor (AI Anime pipeline — server-side only)
# Prefer VIDMOR_TOKEN_B64 on Vercel: bcrypt tokens contain `$` and break shell/CLI env injection.
# Encode: node -e "console.log(Buffer.from('YOUR_TOKEN').toString('base64'))"
# Example shape only — use your own token from vidmor.ai Console.
VIDMOR_TOKEN_B64=
VIDMOR_USER_CODE=
# Local dev alternative (do not use on Vercel CLI with unquoted `$` values):
# VIDMOR_TOKEN=
# Optional overrides
# VIDMOR_API_BASE_URL=https://mrc.aiimagery.top
# NEXT_PUBLIC_APP_URL=https://tiktok-account-tracker.vercel.app
# Max parallel Vidmor generations (default 5, max 5). Extra jobs queue automatically.
# ANIME_MAX_CONCURRENT_JOBS=5

# Skip TikHub if account synced within this many minutes (default 360 = 6h). Sync Now uses force=true.
SYNC_CACHE_MINUTES=360

# Vercel Cron: protect /api/cron/sync (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-in-production

TRACKER_PASSWORD=zhaoeven
TRACKER_SESSION_TOKEN=change-me-in-production

# Team Workspace auth (JWT session secret — use a long random string in production)
SESSION_SECRET=change-me-in-production-session-secret
WORKSPACE_NAME=My Company
BOOTSTRAP_ADMIN_EMAIL=admin@company.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-in-production
BOOTSTRAP_ADMIN_NAME=Admin

# Deprecated (Apify removed — kept only if you still have old env vars locally)
# APIFY_TOKEN=
# APIFY_SYNC_CACHE_MINUTES=360
